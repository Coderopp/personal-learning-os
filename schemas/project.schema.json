{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PracticeProject",
  "description": "The Practice step of a learning path: a small, concrete project. Generated by the agent, then edited freely by the learner in the app.",
  "type": "object",
  "required": ["title", "summary", "goal", "context", "requirements", "milestones", "deliverables", "acceptance_criteria", "stack", "starter_resources", "stretch_goals", "estimated_hours", "difficulty", "where_to_build"],
  "properties": {
    "title": { "type": "string", "description": "Short project name" },
    "summary": { "type": "string", "description": "One or two sentences: what you will build" },
    "goal": { "type": "string", "description": "The capability this project proves" },
    "context": { "type": "string", "description": "Why this matters for the competency; the real-world situation it mirrors" },
    "requirements": { "type": "array", "items": { "type": "string" }, "description": "Functional requirements, each testable" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description", "acceptance"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string", "description": "What to do in this milestone" },
          "acceptance": { "type": "string", "description": "How you know it is done (observable)" }
        }
      }
    },
    "deliverables": { "type": "array", "items": { "type": "string" }, "description": "What exists at the end (code, notebook, write-up, demo)" },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "description": "Project-level definition of done" },
    "stack": { "type": "array", "items": { "type": "string" }, "description": "Languages, libraries, tools" },
    "starter_resources": {
      "type": "array",
      "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string" }, "url": { "type": "string" } } }
    },
    "stretch_goals": { "type": "array", "items": { "type": "string" } },
    "estimated_hours": { "type": "number", "minimum": 0.5, "maximum": 40 },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
    "where_to_build": { "enum": ["browser", "local", "colab"], "description": "browser = runs in Learning OS (NumPy/pandas); local = your machine; colab = Google Colab (GPU / PyTorch)" },
    "notes": { "type": "string", "description": "Your own notes; never overwritten by the agent" }
  }
}
