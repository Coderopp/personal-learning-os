{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mission",
  "type": "object",
  "required": ["id", "title", "goal", "mode", "excellence", "competencies"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["mastery", "project"] },
    "role": { "enum": ["primary", "exploration"] },
    "level": { "type": "string" },
    "target": { "type": "integer", "minimum": 1, "maximum": 100 },
    "excellence": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "description"], "properties": { "name": { "type": "string" }, "description": { "type": "string" } } }
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "prerequisites"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "prerequisites": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string" }, "description": { "type": "string" }, "competency_id": { "type": ["string", "null"] } } }
    }
  }
}
